# Application Configuration
APP_NAME="SocialSense AI Backend"
DEBUG=True
PORT=8000

# PostgreSQL Database Connection
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/socialsense_db"

# Apify Configuration
APIFY_API_TOKEN="apify_api_primary_token_here"
# Backup Apify Token (automatically used if primary token hits monthly quota / credit limit)
APIFY_BACKUP_API_TOKEN="apify_api_backup_token_here"
# Or provide multiple comma-separated backup tokens:
# APIFY_API_TOKENS="apify_api_key_1,apify_api_key_2,apify_api_key_3"

# Claude / Gemini Sentiment API (Optional, falls back to local fast classifier)
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
